LOCAL_PATH := $(call my-dir)

# Termux (Pre-installed Terminal App)
include $(CLEAR_VARS)
LOCAL_MODULE := Termux
LOCAL_MODULE_TAGS := optional
LOCAL_SRC_FILES := Termux.apk
LOCAL_MODULE_CLASS := APPS
LOCAL_CERTIFICATE := PRESIGNED
LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
LOCAL_PRODUCT_MODULE := true
include $(BUILD_PREBUILT)

# Termux:Boot (Auto-start Linux Daemons on phone boot)
include $(CLEAR_VARS)
LOCAL_MODULE := TermuxBoot
LOCAL_MODULE_TAGS := optional
LOCAL_SRC_FILES := TermuxBoot.apk
LOCAL_MODULE_CLASS := APPS
LOCAL_CERTIFICATE := PRESIGNED
LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
LOCAL_PRODUCT_MODULE := true
include $(BUILD_PREBUILT)

# Termux:API (Hardware Sensor & System API Access from Python/CLI)
include $(CLEAR_VARS)
LOCAL_MODULE := TermuxAPI
LOCAL_MODULE_TAGS := optional
LOCAL_SRC_FILES := TermuxAPI.apk
LOCAL_MODULE_CLASS := APPS
LOCAL_CERTIFICATE := PRESIGNED
LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
LOCAL_PRODUCT_MODULE := true
include $(BUILD_PREBUILT)

# KernelSU Manager App (Userland Root Management Interface)
include $(CLEAR_VARS)
LOCAL_MODULE := KernelSU
LOCAL_MODULE_TAGS := optional
LOCAL_SRC_FILES := KernelSU.apk
LOCAL_MODULE_CLASS := APPS
LOCAL_CERTIFICATE := PRESIGNED
LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
LOCAL_SYSTEM_EXT_MODULE := true
include $(BUILD_PREBUILT)
