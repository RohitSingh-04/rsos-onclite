#
# Init Configuration for onclite Android 16 Micro-Server & Resource Optimizer
#

on early-init
    # Set swappiness to favor anonymous memory compression in ZRAM
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/vfs_cache_pressure 100
    write /proc/sys/vm/dirty_ratio 20
    write /proc/sys/vm/dirty_background_ratio 5

on post-fs-data
    # Create persistent runtime directory for Linux server daemons
    mkdir /data/local/server 0777 root root
    mkdir /data/local/server/run 0777 root root
    mkdir /data/local/server/logs 0777 root root
    chmod 0777 /data/local/tmp

on property:sys.boot_completed=1
    # Initialize 2.5 GB ZRAM for 3 GB physical RAM device
    write /sys/block/zram0/comp_algorithm lz4
    write /sys/block/zram0/disksize 2684354560
    mkswap /dev/block/zram0
    swapon /dev/block/zram0 -p 32758

    # Prevent Android Framework from throttling or killing background server processes
    write /proc/sys/kernel/sched_tunable_scaling 0
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 960000

    # Whitelist Termux and Python servers from battery optimization
    exec u:r:su:s0 root root -- /system/bin/sh -c "dumpsys deviceidle whitelist +com.termux"
    exec u:r:su:s0 root root -- /system/bin/sh -c "/system/bin/device_config put activity_manager max_phantom_processes 2147483647"

    # Start optional background init server service
    start onclite_server_boot

service onclite_server_boot /system/bin/sh /data/local/server/on_boot.sh
    class late_start
    user root
    group root system shell
    disabled
    oneshot
